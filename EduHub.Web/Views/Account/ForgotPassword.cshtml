@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
    ViewData["Description"] = "Recover access to your EduHub account.";
    ViewData["HeaderContext"] = "ACCOUNT RECOVERY";
}

@section Styles {
  <link rel="stylesheet" href="~/css/auth/forgot-password.css" asp-append-version="true" />
}

<div class="recovery-card">
  <partial name="_ForgotPasswordRequest" />
  <partial name="_ForgotPasswordSuccess" />
</div>

@section Scripts {
  <script src="~/js/auth/forgot-password.js" asp-append-version="true"></script>
}
