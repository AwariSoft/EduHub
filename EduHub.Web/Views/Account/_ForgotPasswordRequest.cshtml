<div id="requestState">
  <div class="recovery-motif" aria-hidden="true"><i class="fa-regular fa-envelope"></i></div>

  <div class="recovery-intro">
    <h1 id="recovery-title" class="recovery-title">Forgot Password?</h1>
    <p class="recovery-description">Enter the email address associated with your account. We’ll help you reset your password.</p>
  </div>

  <form id="recoveryForm" class="recovery-form" novalidate>
    <div class="field-group">
      <label for="email" class="field-label">Email Address</label>
      <div class="field-wrap">
        <i class="fa-regular fa-envelope field-icon" aria-hidden="true"></i>
        <input class="auth-input" id="email" name="email" type="email" placeholder="you@@example.com" autocomplete="email" inputmode="email" maxlength="254" aria-describedby="emailError" required>
      </div>
      <p id="emailError" class="field-error" aria-live="polite"></p>
    </div>
    <button id="sendResetButton" class="action-button" type="submit">Send Reset Link</button>
    <div id="formFeedback" class="form-feedback" role="status" aria-live="polite" aria-atomic="true"></div>
  </form>

  <div class="return-wrap">
    <a class="return-link" asp-controller="Account" asp-action="Login"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to Log In</a>
  </div>
  <p id="demoNote" class="demo-note">Static account-recovery demo. No email is sent.</p>
</div>
