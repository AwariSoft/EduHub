@* Shown only after a successful response from a configured API. *@
<div id="successState" class="success-state" aria-live="polite" hidden>
  <div class="recovery-motif" aria-hidden="true"><i class="fa-regular fa-envelope"></i></div>

  <div class="recovery-intro">
    <h2 class="recovery-title">Check Your Email</h2>
    <p class="recovery-description">If an EduHub account exists for <strong id="confirmationEmail"></strong>, you'll receive a password reset link. Check your inbox and spam folder.</p>
  </div>

  <button class="outline-button" id="tryAnotherEmail" type="button">Try Another Email</button>

  <div class="return-wrap">
    <a class="return-link" asp-controller="Account" asp-action="Login"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to Log In</a>
  </div>
</div>
