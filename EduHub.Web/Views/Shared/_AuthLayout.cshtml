<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#dbeafe">
  <meta name="description" content="@ViewData["Description"]">
  <title>@ViewData["Title"] | EduHub</title>

  <!-- Vendor: Bootstrap 5, Font Awesome 6 Free, Inter -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" referrerpolicy="no-referrer">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Shared auth CSS (same for every auth page) -->
  <link rel="stylesheet" href="~/css/auth/auth-base.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/auth/auth-header.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/auth/auth-layout.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/auth/auth-brand-panel.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/css/auth/auth-footer.css" asp-append-version="true" />

  <!-- Page-specific CSS -->
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <partial name="Auth/_AuthHeader" />

  <main class="recovery-main" aria-label="@ViewData["Title"]">
    <div class="recovery-layout mx-auto">
      <div class="row gx-0 align-items-center">
        <section class="col-xl-7 d-none d-xl-block" aria-labelledby="learning-tagline">
          <partial name="Auth/_BrandPanel" />
        </section>

        <section class="col-12 col-xl-5" aria-labelledby="recovery-title">
          @RenderBody()
        </section>
      </div>
    </div>
  </main>

  <partial name="Auth/_AuthFooter" />

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
